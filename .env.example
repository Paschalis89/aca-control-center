# ==============================================================================
# ACA CONTROL CENTER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for the first setup:
#   cp .env.example .env
#
# IMPORTANT:
# - .env contains secrets. Never commit it to GitHub or share its contents.
# - On an already configured server, EDIT the existing .env instead of copying
#   this example over it. Replacing existing values may break logins or DB access.
# - Do not add spaces around the '=' sign.
# - Production values below expect the site to use HTTPS through Traefik.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. APPLICATION / PUBLIC URL
# ------------------------------------------------------------------------------
# The precise URL used by the browser; no trailing slash.
# This is validated for requests that change application data.
PUBLIC_ORIGIN=https://control.amalficoastartistry.com

# Use true when the site is served through HTTPS.
# Use false ONLY for the initial localhost SSH-tunnel setup.
COOKIE_SECURE=true


# ------------------------------------------------------------------------------
# 2. AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret used to sign user authentication tokens.
# Generate one strong random value on the server:
#   openssl rand -hex 48
# IMPORTANT: Preserve the same value across deploys. Changing it invalidates
# all existing sessions.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_48_CHARS


# ------------------------------------------------------------------------------
# 3. INITIAL ADMINISTRATOR (DATABASE SEED)
# ------------------------------------------------------------------------------
# These credentials are used by the initial database seed operation.
# They are not intended to replace user management inside the application.
# Never use the sample email or password in a real deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="ACA Administrator"
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_20_PLUS_CHARACTER_PASSWORD


# ------------------------------------------------------------------------------
# 4. POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Docker Compose uses these values to initialize PostgreSQL and to build the
# backend DATABASE_URL automatically. No separate DATABASE_URL is needed here.
# Generate the password once, e.g.:
#   openssl rand -hex 24
# IMPORTANT: If the database volume already exists, do not change these
# variables casually: changing POSTGRES_PASSWORD here alone does not update
# the password stored inside an existing PostgreSQL instance.
POSTGRES_USER=aca_control
POSTGRES_DB=aca_control
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD


# ------------------------------------------------------------------------------
# 5. TRAEFIK / LET'S ENCRYPT (HTTPS)
# ------------------------------------------------------------------------------
# REQUIRED when running with docker-compose.traefik.yml.
# Let's Encrypt may use this email for important certificate notices.
# Use a real, monitored mailbox. It does not have to match ADMIN_EMAIL.
ACME_EMAIL=REPLACE_WITH_YOUR_REAL_EMAIL@example.com


# ------------------------------------------------------------------------------
# 6. SHOPIFY (OPTIONAL: STEP 2, READ ONLY)
# ------------------------------------------------------------------------------
# Shop must end with .myshopify.com. Example: your-store.myshopify.com
# Create a Shopify custom app with read_orders (and read_all_orders for >60 days).
# Do not commit actual tokens. If blank, the integration remains disabled.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Max order pages per manual synchronization (50 orders/page, capped in backend).
SHOPIFY_SYNC_MAX_PAGES=4

# ------------------------------------------------------------------------------
# 7. ACA CRM (OPTIONAL: FUTURE READ ONLY)
# ------------------------------------------------------------------------------
# The local Partners module works without ACA CRM. External sync requires an
# agreed API contract; no CRM token is needed for the current release.
ACA_CRM_API_URL=
ACA_CRM_API_TOKEN=

# ------------------------------------------------------------------------------
# 8. OPTIONAL AI (STEP 4, OFF BY DEFAULT)
# ------------------------------------------------------------------------------
# An explicit opt-in is required: AI sends aggregate financial alerts + question
# to the selected API provider; it never sends order PII or uploaded receipts.
FINANCIAL_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
