# Generate this securely before deploying: openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_48_CHARS
# Seed the first admin exactly once. Never commit live credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=ACA Administrator
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_20_PLUS_CHARACTER_PASSWORD
# Initial access via localhost SSH tunnel can use false; set true when behind HTTPS.
COOKIE_SECURE=false
# Set to the exact browser origin. Eg http://localhost:8085 during SSH tunnel or https://control.amalficoastartistry.com with TLS.
PUBLIC_ORIGIN=http://localhost:8085
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=aca_control
POSTGRES_USER=aca_control
